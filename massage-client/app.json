      }
    },

    "android": {
      "package": "com.hoangan.inhomemassage247.client",
      "versionCode": 1,

      "adaptiveIcon": {
        "foregroundImage": "./src/assets/splash-icon-client-small.png",
        "backgroundColor": "#ffffff"
      },

      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },

    "web": {
      "favicon": "./src/assets/splash-icon-client-small.png"
    },

    "plugins": [
      "expo-router",
      "expo-location",
      "expo-image-picker",

